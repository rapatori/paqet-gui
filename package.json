{
  "name": "paqet-gui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "packageManager": "npm@12.0.1",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:sidecar": "node --test scripts/build-sidecar.test.mjs",
    "test:webview": "npm run tauri -- build --debug --no-bundle && node scripts/verify-windows-webview.mjs",
    "test:webview:accessibility": "npm run tauri -- build --debug --no-bundle && node scripts/verify-windows-webview.mjs --accessibility",
    "test:webview:clipboard:destructive": "npm run tauri -- build --debug --no-bundle && node scripts/verify-windows-webview.mjs --accessibility --destructive-clipboard",
    "test:webview:sidecar": "npm run tauri:sidecar -- --debug --no-bundle && node scripts/verify-windows-webview.mjs --sidecar",
    "tauri": "tauri",
    "tauri:sidecar": "node scripts/build-sidecar.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "eslint-plugin-svelte": "3.22.0",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.7",
    "svelte-check": "4.7.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  }
}
