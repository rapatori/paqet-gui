{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Application command capability for the local paqet main window.",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "allow-get-app-snapshot",
    "allow-create-profile",
    "allow-update-profile",
    "allow-delete-profile",
    "allow-select-profile",
    "allow-refresh-interfaces",
    "allow-select-interface",
    "allow-replace-advanced-settings",
    "allow-connect",
    "allow-disconnect",
    "allow-subscribe-runtime-events",
    "allow-subscribe-window-close-requests",
    "allow-cancel-window-close",
    "allow-confirm-window-close"
  ]
}
