{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "paqet",
  "version": "0.1.0",
  "identifier": "io.github.rapatori.paqet-gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "paqet",
        "width": 440,
        "height": 760,
        "minWidth": 320,
        "minHeight": 568,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'self'",
      "devCsp": "default-src 'self' http://localhost:1420; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; img-src 'self' asset: http://asset.localhost data:; style-src 'self' http://localhost:1420 'unsafe-inline'; script-src 'self' http://localhost:1420 'unsafe-eval'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "publisher": "paqet-gui contributors",
    "homepage": "https://github.com/rapatori/paqet-gui",
    "copyright": "Copyright (c) 2026 paqet-gui contributors",
    "licenseFile": "../LICENSE",
    "shortDescription": "A lightweight Windows desktop client for paqet",
    "icon": ["icons/icon.ico"],
    "resources": {
      "../LICENSE": "licenses/PAQET_GUI_LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../licenses/FRONTEND_THIRD_PARTY_LICENSES.txt": "licenses/FRONTEND_THIRD_PARTY_LICENSES.txt",
      "../licenses/PAQET_THIRD_PARTY_LICENSES.txt": "licenses/PAQET_THIRD_PARTY_LICENSES.txt",
      "../licenses/RUST_THIRD_PARTY_LICENSES.txt": "licenses/RUST_THIRD_PARTY_LICENSES.txt",
      "../src/assets/fonts/SPACE_GROTESK_OFL.txt": "licenses/fonts/SPACE_GROTESK_OFL.txt",
      "../src/assets/fonts/JETBRAINS_MONO_OFL.txt": "licenses/fonts/JETBRAINS_MONO_OFL.txt"
    },
    "targets": ["nsis"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "compression": "lzma",
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"]
      }
    }
  }
}
